---
import { StoryblokBlock } from './index.js'

const { block, editable, language } = Astro.props
---

<main {...editable} class="has-[>*:nth-child(3)]:space-y-16 has-[>*:nth-child(3)]:md:space-y-32">
  {
    block.body?.map((child) => <StoryblokBlock block={child} language={language} />)
  }
</main>
