---
import { Image } from 'astro:assets'
import { Avatar } from '@/components/ui/avatar'
import { Card } from '@/components/ui/card'
import { flatCard } from '@/lib/ui'
import ArrowLink from '../components/ArrowLink.astro'
const { block, editable } = Astro.props
---

<section {...editable}>
  <div class="container mx-auto px-6">
    {block.title && <h2 class="text-black text-3xl md:text-5xl leading-[120%] font-heading mb-8 px-6 max-w-[430px]">{block.title}</h2>}

    <ul class="space-y-3">
      {block.advisers && block.advisers.map((adviser) => (
        <li>
          <Card class:list={[flatCard, 'flex-row flex-wrap items-center justify-center gap-5 p-10 sm:justify-between']}>
            <div class="flex flex-col sm:flex-row items-center gap-4">
              <Avatar class="size-16">
                <Image
                  data-slot="avatar-image"
                  class="size-full rounded-full object-cover"
                  src={`${adviser.image.filename}/m/128x0`}
                  alt={adviser.image.alt}
                  width={64}
                  height={64}
                  loading="lazy"
                />
              </Avatar>
              <div>
                <h3 class="mb-2 text-[1.5rem] md:text-[1.75rem] text-center sm:text-left">{adviser.name}</h3>
                <p class="opacity-65 text-center sm:text-left">{adviser.role}</p>
              </div>
            </div>
            <p class="max-w-96 opacity-65">{adviser.description}</p>
            <ArrowLink href={adviser.link.cached_url} class="ml-auto" />
          </Card>
        </li>
      ))}
    </ul>
  </div>
</section>
