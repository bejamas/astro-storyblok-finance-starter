---
import { StoryblokBlock } from './index.js'
import { Image } from 'astro:assets'
import { Card } from '@/components/ui/card'
import { flatCard } from '@/lib/ui'
const { block, editable } = Astro.props
---

<section {...editable}>
  <div class="container mx-auto px-6">
    <Card class:list={[flatCard, 'grid gap-16 p-6 md:grid-cols-2 md:p-16']}>
      <div class="flex flex-col justify-between items-start gap-8">
        {block.heading && block.heading.length > 0 && (
          <StoryblokBlock block={block.heading[0]} />
        )}
        <div class="flex flex-col justify-center items-start grow max-w-[476px]">
          <h3 class="text-black text-3xl lg:text-5xl leading-[120%] font-heading mb-4">{block.headline}</h3>
          {block.lead && (
            <p class="mb-8 text-black opacity-65">
              {block.lead}
            </p>
          )}
        </div>
        {block.button && block.button.length > 0 && (
          <StoryblokBlock block={block.button[0]} />
        )}
      </div>
      <div>
        <Image
          src={`${block.image.filename}/m/906x0`}
          alt={block.image.alt}
          width={453}
          height={543}
          layout="full-width"
          loading="lazy"
        />
      </div>
    </Card>
  </div>
</section>
