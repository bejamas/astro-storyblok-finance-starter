---
import { Image } from 'astro:assets'
import ArrowLink from '../components/ArrowLink.astro'
const { block, editable } = Astro.props
---

<section {...editable}>
  <div class="container mx-auto px-6">
    {block.title && <h2 class="text-3xl md:text-5xl text-center font-heading mb-16 px-6">{block.title}</h2>}

    <ul class="grid md:grid-cols-2 gap-y-16 gap-x-5">
      {block.members && block.members.map((member) => (
        <li class="relative group">
          <Image
            class="block w-full"
            src={`${member.image.filename}/m/1078x0`}
            alt={member.image.alt}
            width={539}
            height={315}
            layout="full-width"
            loading="lazy"
          />
          <div class="flex items-center justify-between gap-2 mt-4 text-black">
            <h3 class="text-2xl">{member.name}</h3>
            <span class="text-sm">{member.role}</span>
          </div>
          <ArrowLink reveal href={member.link.cached_url} class="-top-[8px] right-[24px]" />
        </li>
      ))}
    </ul>
  </div>
</section>
