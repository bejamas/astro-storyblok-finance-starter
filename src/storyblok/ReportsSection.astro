---
import { StoryblokBlock } from './index.js'
import ReportCard from '../components/ReportCard.astro'
const { block, editable, language } = Astro.props
---

<section {...editable} class="bg-black">
  <div class="container mx-auto px-6 py-24 flex flex-col items-center gap-16">
    {block.title && <h2 class="text-white text-3xl md:text-5xl text-center leading-[120%] font-heading mb-16 px-6">{block.title}</h2>}

    <ul class="grid md:grid-cols-3 gap-6">
      {
        block.reports.length &&
          block.reports.map((report) => {
            report.content.slug = report.slug
            return (
              <li>
                <ReportCard language={language} report={report.content} />
              </li>
            )
          })
      }
    </ul>

    {block.button && block.button.length > 0 && (
      <StoryblokBlock block={block.button[0]} />
    )}
  </div>
</section>
