---
import { Image } from 'astro:assets'
import { Card, CardContent, CardHeader, CardTitle } from '@/components/ui/card'
import { flatCard } from '@/lib/ui'
const { block, editable } = Astro.props
---

<section {...editable}>
  <div class="container mx-auto px-6">
    {block.title && <h2 class="text-black text-3xl md:text-5xl leading-[120%] font-heading mb-8 px-6 max-w-[430px]">{block.title}</h2>}

    <ul class="grid md:grid-cols-3 gap-6">
      {block.features && block.features.map((feature) => (
        <li>
          <Card class:list={[flatCard, 'h-full']}>
            <CardHeader class="gap-0 rounded-none p-6">
              <CardTitle class="text-xl font-normal text-wrap capitalize">
                <h3>{feature.title}</h3>
              </CardTitle>
            </CardHeader>
            <Image
              src={`${feature.image.filename}/m/700x0`}
              alt={feature.image.alt}
              width={350}
              height={242}
              layout="full-width"
              loading="lazy"
            />
            <CardContent class="p-6">
              <p class="opacity-65">{feature.description}</p>
            </CardContent>
          </Card>
        </li>
      ))}
    </ul>
  </div>
</section>
