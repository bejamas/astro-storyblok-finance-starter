---
import { StoryblokBlock } from './index.js'
const { block, editable } = Astro.props
---

<section {...editable}
  class="bg-no-repeat bg-cover bg-center"
  style={`background-image: ${block.image.filename ? `url('${block.image.filename}/m/1440x0/filters:quality(90)')` : ''}`}
  >

  <div class="container mx-auto flex flex-col justify-between items-start min-h-[80vh] py-16 px-6">

    {block.heading && block.heading.length > 0 && (
      <StoryblokBlock block={block.heading[0]} />
    )}

    <div class="max-w-[474px]">
      <h2 class="text-white text-3xl md:text-5xl leading-[120%] font-heading mb-10">{block.headline}</h2>
      {block.button && block.button.length > 0 && (
        <StoryblokBlock block={block.button[0]} />
      )}
    </div>
  </div>

</section>
