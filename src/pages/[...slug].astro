---
import { getPayload, StoryblokPreview } from '@storyblok/astro'
import { getStory, getSiteSettings } from '../utils/api'
import { StoryblokBlock } from '../storyblok/index.js'
import Layout from '../layouts/Layout.astro'
import parseUrl from '../utils/parseUrl'
import isPreview from '../utils/isPreview'
import generateStaticPaths from '../utils/generateStaticPaths'
import * as locales from '../locales'

export async function getStaticPaths() {
  return await generateStaticPaths()
}

const params = Astro.params

let props = isPreview() ? parseUrl(params.slug) : Astro.props

const { slug, language, langSwitch } = props

const siteSettings = await getSiteSettings(language)

const translate = locales[language] || locales.en

// During a Visual Editor live update, render the edited story instead of fetching it
const payload = await getPayload({ locals: Astro.locals })
const story = payload.story ?? (await getStory(slug, language))
---

<Layout blok={story.content} siteSettings={siteSettings.content} langSwitch={langSwitch} language={language} translate={translate}>
  <StoryblokBlock block={story.content} language={language} translate={translate} />
  <!-- Reloads on save in the Visual Editor; live updates while typing need an on-demand route -->
  <StoryblokPreview liveUpdate={!Astro.isPrerendered} bridgeOptions={{ resolveRelations: ['reports_section.reports'] }} />
</Layout>
