---
import { Button } from '@/components/ui/button'

const { label, href, variant = 'primary', classes } = Astro.props

// Storyblok's button styles mapped to bejamas/ui Button variants
const variants = {
  primary: 'default',
  secondary: 'secondary',
}
---

<Button
  as="a"
  href={href}
  variant={variants[variant] || variants.primary}
  class:list={['h-auto rounded-sm border-0 px-5 py-4 text-center text-base tracking-[-0.64px] whitespace-normal', classes]}
>
  {label}
</Button>
