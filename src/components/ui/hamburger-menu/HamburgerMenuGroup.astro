---
import { cn } from "@/lib/utils";

import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"details"> {
  label: string;
  defaultOpen?: boolean;
  class?: string;
}

const { label, defaultOpen = false, class: className = "", ...rest } = Astro.props as Props;
---

<details
  {...rest}
  data-slot="hamburger-menu-group"
  open={defaultOpen}
  class={cn("group/hamburger-menu-group", className)}
>
  <summary class="flex min-h-10 cursor-pointer list-none items-center justify-between rounded-md py-2 pr-1 text-xs font-semibold leading-4 text-muted-foreground outline-none marker:hidden hover:text-foreground focus-visible:ring-2 focus-visible:ring-ring [&::-webkit-details-marker]:hidden">
    {label}
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" class="size-[18px] group-open/hamburger-menu-group:hidden"><path fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m6 9l6 6l6-6"/></svg>
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" class="hidden size-[18px] group-open/hamburger-menu-group:block"><path fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m18 15l-6-6l-6 6"/></svg>
  </summary>
  <div data-slot="hamburger-menu-group-content" class="flex flex-col gap-1.5 pb-2">
    <slot />
  </div>
</details>
